diff --git a/frontend/src/index.css b/frontend/src/index.css
index 1a8b313d..de5b3767 100644
--- a/frontend/src/index.css
+++ b/frontend/src/index.css
@@ -2650,9 +2650,70 @@ html[data-electron="darwin"]
   -webkit-app-region: no-drag;
 }
 
+/* 桌面端移除 header（去标题 + 去直通顶端分隔线）后，原本由 header 承担的
+ * drag region 一并消失 —— 窗口抓不住、双击也无法 zoom（最大化）。
+ * 这里用绝对定位伪元素把顶部补回 drag 区：不占布局流，不推动任何元素。
+ *   - 侧栏顶部 0~52px：红绿灯下沿；WorkspaceSwitcher 从 60px 起，不会挡住交互
+ *   - rail  顶部 0~28px：rail 图标从 28px 起（padding-top），不会挡住按钮
+ */
+html[data-electron="darwin"]
+  [data-unified-sidebar][data-sidebar-variant="desktop"] {
+  position: relative;
+}
+
+html[data-electron="darwin"]
+  [data-unified-sidebar][data-sidebar-variant="desktop"]::before {
+  content: "";
+  position: absolute;
+  top: 0;
+  left: 0;
+  right: 0;
+  height: 52px;
+  -webkit-app-region: drag;
+  z-index: 2;
+}
+
+html[data-electron="darwin"] .nav-rail::before {
+  content: "";
+  position: absolute;
+  top: 0;
+  left: 0;
+  right: 0;
+  height: 28px;
+  -webkit-app-region: drag;
+  z-index: 2;
+}
+
+/* 全屏时灯区消失、rail 内容上移到 4px，拖拽区让位，否则会盖住前几个图标 */
+html[data-electron="darwin"][data-fullscreen="1"] .nav-rail::before {
+  height: 0;
+}
+
 /* Keep rail actions below the native window controls. */
 html[data-electron="darwin"] .nav-rail {
-  padding-top: 56px !important;
+  padding-top: 28px !important;
+}
+
+/* macOS: 侧栏竖线（rail 右缘）不从红绿灯底下穿过。
+ * 去掉通高的 border-r，改用伪元素从灯区下方起画：
+ * 灯底在 52px（trafficLightPosition y:14 + 12pt 灯高），留 8px 间隙 → 60px。
+ * 全屏时系统隐藏红绿灯，竖线恢复通高。 */
+html[data-electron="darwin"] .nav-rail {
+  position: relative;
+  border-right-width: 0;
+}
+html[data-electron="darwin"] .nav-rail::after {
+  content: "";
+  position: absolute;
+  top: 60px;
+  right: 0;
+  bottom: 0;
+  width: 1px;
+  background: var(--color-border);
+  pointer-events: none;
+}
+html[data-electron="darwin"][data-fullscreen="1"] .nav-rail::after {
+  top: 0;
 }
 
 /* Fullscreen hides Traffic Lights, so restore the regular header inset. */
@@ -2685,10 +2746,16 @@ html[data-electron="darwin"] main::before {
   right: 0;
   height: 28px;
   -webkit-app-region: drag;
-  pointer-events: none; /* 涓嶉樆鎸′笅灞傜偣鍑?*/
   z-index: 1;
 }
 
+/* drag 区会拦截命中测试，其覆盖范围内的交互元素必须显式 no-drag 才能点击。
+ * 编辑器顶栏（Live/已保存/锁/星标/分享…）、列表顶部按钮、欢迎页标签输入
+ * 都落在 main 顶部 28px 内，靠这条通配规则保住交互；拖拽/双击走空白处。 */
+html[data-electron="darwin"] main :is(button, a, input, select, textarea, [role="button"], [contenteditable="true"]) {
+  -webkit-app-region: no-drag;
+}
+
 /* main 闇€瑕佹槸 relative锛?:before 鎵嶈兘瀹氫綅鍒板畠 */
 html[data-electron="darwin"] main {
   position: relative;
