#!/bin/bash
# =============================================================================
# Nowen Note 直装版主控脚本（fnOS 原生应用，不经过 Docker）
# -----------------------------------------------------------------------------
# 生命周期由飞牛应用中心调用：start / stop / status。
#   start   准备数据目录与密钥，后台拉起 Node backend，等待 /api/health 就绪
#   stop    停止 backend 进程
#   status  进程存活且健康检查通过 → 0；否则 → 3
#
# 目录约定（飞牛文档）：
#   - TRIM_APPDEST 指向 target/，app.tgz 的内容直接解在这里
#     （node/、backend/、frontend/、ui/、package.json）
#   - TRIM_PKGVAR 是系统托管的持久运行数据目录（数据库、密钥、日志），
#     属主固定为应用运行用户，重启与升级保留
#
# 密钥与数据逻辑复刻 docker-entrypoint.sh：
#   - JWT_SECRET 生产环境必填；未提供时在数据目录维护 .jwt_secret
#     （首次生成、之后复用，重启/升级不被登出）
#   - 每台部署机独立随机密钥，不使用硬编码默认值
# =============================================================================

APPDEST="${TRIM_APPDEST:-/var/apps/nowen-note/target}"
if [ -f "$APPDEST/app/backend/dist/index.hardened.js" ]; then
    APP_HOME="$APPDEST/app"
else
    APP_HOME="$APPDEST"
fi
# 数据目录：安装向导自定义位置 > 安装时保存的配置 > 默认应用数据目录。
APPNAME="${TRIM_APPNAME:-nowen-note}"
DATA_DIR=""
if [ -n "${wizard_data_dir:-}" ]; then
    DATA_DIR="${wizard_data_dir%/}/nowen-note"
fi
if [ -z "$DATA_DIR" ]; then
    CONF_FILE="${TRIM_PKGETC:-/var/apps/$APPNAME/etc}/data-dir"
    if [ -f "$CONF_FILE" ]; then
        DATA_DIR="$(cat "$CONF_FILE" 2>/dev/null)"
    fi
fi
[ -n "$DATA_DIR" ] || DATA_DIR="${TRIM_PKGVAR:-/var/apps/$APPNAME/var}"
PID_FILE="$DATA_DIR/nowen-note.pid"
LOG_FILE="$DATA_DIR/nowen-note.log"
NODE_BIN="$APP_HOME/node/bin/node"
BACKEND_ENTRY="$APP_HOME/backend/dist/index.hardened.js"
PORT="${NOWEN_PORT:-19010}"

ensure_secret() {
    if [ -z "${JWT_SECRET:-}" ] || [ "${#JWT_SECRET}" -lt 16 ]; then
        local secret_file="$DATA_DIR/.jwt_secret"
        local size=0
        if [ -f "$secret_file" ] && [ -r "$secret_file" ]; then
            size="$(wc -c < "$secret_file" 2>/dev/null | tr -d ' ')"
        fi
        case "$size" in
            ''|*[!0-9]*) size=0 ;;
        esac
        if [ "$size" -ge 16 ]; then
            JWT_SECRET="$(cat "$secret_file")"
        else
            if command -v openssl >/dev/null 2>&1; then
                JWT_SECRET="$(openssl rand -base64 48 | tr -d '\n')"
            else
                JWT_SECRET="$("$NODE_BIN" -e 'process.stdout.write(require("crypto").randomBytes(48).toString("base64"))')"
            fi
            printf %s "$JWT_SECRET" > "$secret_file"
            chmod 600 "$secret_file" 2>/dev/null || true
        fi
        export JWT_SECRET
    fi
}

is_running() {
    [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null
}

health_check() {
    [ -x "$NODE_BIN" ] || return 1
    "$NODE_BIN" -e '
const http = require("http");
const req = http.get({ host: "127.0.0.1", port: process.argv[1], path: "/api/health", timeout: 2000 }, (res) => {
  res.resume();
  process.exit(res.statusCode === 200 ? 0 : 1);
});
req.on("timeout", () => { req.destroy(); process.exit(1); });
req.on("error", () => process.exit(1));
' "$PORT" >/dev/null 2>&1
}

wait_healthy() {
    local i
    for i in $(seq 1 60); do
        health_check && return 0
        is_running || return 1
        sleep 1
    done
    return 1
}

do_start() {
    if is_running; then
        exit 0
    fi
    mkdir -p "$DATA_DIR" 2>/dev/null
    ensure_secret

    export NODE_ENV=production
    # 飞牛直装包按 Lite profile 运行：关闭 P1 模块（ai/tasks/分享/插件等），
    # 与前端 VITE_LITE=1 构建的界面一致。
    export NOWEN_PROFILE=lite
    export PORT="$PORT"
    export DB_PATH="$DATA_DIR/nowen-note.db"
    export ELECTRON_USER_DATA="$DATA_DIR"
    export FRONTEND_DIST="$APP_HOME/frontend/dist"
    # 打包时注入，避免 NAS 面板复用旧环境变量导致版本号停留下次升级前
    export NOWEN_APP_VERSION="{{VERSION}}"

    cd "$APP_HOME" || exit 1
    # setsid 脱离应用中心进程组，避免应用中心重启时被连带杀掉（缺失时降级为普通后台进程）
    if command -v setsid >/dev/null 2>&1; then
        nohup setsid "$NODE_BIN" "$BACKEND_ENTRY" >> "$LOG_FILE" 2>&1 &
    else
        nohup "$NODE_BIN" "$BACKEND_ENTRY" >> "$LOG_FILE" 2>&1 &
    fi
    echo $! > "$PID_FILE"

    if wait_healthy; then
        exit 0
    fi
    echo "[nowen-note] backend 启动失败或 60s 内未就绪，详见 $LOG_FILE" >&2
    exit 1
}

do_stop() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid="$(cat "$PID_FILE" 2>/dev/null)"
        [ -n "$pid" ] && kill "$pid" 2>/dev/null
        local i
        for i in $(seq 1 10); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 1
        done
        [ -n "$pid" ] && kill -9 "$pid" 2>/dev/null
        rm -f "$PID_FILE"
    fi
    exit 0
}

do_status() {
    if is_running && health_check; then
        exit 0
    fi
    exit 3
}

case "$1" in
start)  do_start ;;
stop)   do_stop ;;
status) do_status ;;
*)      exit 1 ;;
esac
