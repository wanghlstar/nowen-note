#!/bin/bash
# 升级后：校验应用负载完整性（此脚本在文件解包之后、以 root 运行）
APPDEST="${TRIM_APPDEST:-/var/apps/nowen-note/target}"
if [ -f "$APPDEST/app/backend/dist/index.hardened.js" ]; then
    APP_HOME="$APPDEST/app"
else
    APP_HOME="$APPDEST"
fi

if [ ! -f "$APP_HOME/backend/dist/index.hardened.js" ]; then
    echo "应用负载不完整：缺少 backend/dist/index.hardened.js，请重新下载安装包。" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
    exit 1
fi
if [ ! -x "$APP_HOME/node/bin/node" ]; then
    echo "应用负载不完整：缺少 node/bin/node 运行时。" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
    exit 1
fi
exit 0
