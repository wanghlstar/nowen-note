{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nowen Note Lite",
  "version": "../package.json",
  "identifier": "com.nowen.note.lite.tauri",
  "build": {
    "beforeDevCommand": "npm --prefix .. run dev:frontend",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix .. run build:frontend",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis", "deb", "appimage"],
    "externalBin": ["binaries/node"],
    "resources": {
      "../../backend/dist": "backend/dist/",
      "../../backend/node_modules": "backend/node_modules/",
      "../../backend/templates": "backend/templates/",
      "../../backend/package.json": "backend/package.json",
      "../../frontend/dist": "frontend/dist/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
